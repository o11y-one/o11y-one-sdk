{
  "name": "@o11y-one/api-agentic",
  "version": "0.1.4",
  "description": "Generated TypeScript types and service descriptors for the O11y One AGENTIC domain (agentic + common only). A per-domain subset of @o11y-one/api so agentic-only consumers do not carry the other domains. Generated from proto at PROTO_PIN — do not edit by hand.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o11y-one/o11y-one-sdk.git",
    "directory": "packages/gen-ts-agentic"
  }
}
